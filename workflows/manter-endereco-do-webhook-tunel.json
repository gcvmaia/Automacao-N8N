[
  {
    "name": "Manter endereço do webhook atualizado (túnel)",
    "description": "A cada 2 minutos, pergunta ao túnel da Cloudflare qual é o endereço atual e, se mudou, atualiza o webhook cadastrado na Asaas.",
    "nodes": [
      {
        "id": "1337aa94-8503-4709-93d5-b1bbe7a0d3de",
        "name": "A cada 2 minutos",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          0,
          0
        ],
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 2
              }
            ]
          }
        }
      },
      {
        "id": "4d03d2c4-b108-4843-ac2d-9abbf978772c",
        "name": "Perguntar endereço ao túnel",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.3,
        "position": [
          224,
          0
        ],
        "parameters": {
          "method": "GET",
          "url": "http://cf-tunnel:20241/quicktunnel",
          "options": {
            "response": {
              "response": {
                "responseFormat": "json"
              }
            },
            "timeout": 5000
          }
